{
  "search": {
    "routing": {
      "provider": "codex-alpha-search",
      "fallback": true,
      "fallbackProvider": "tavily"
    },
    "timeoutMs": 15000,
    "maxResults": 10,
    "codex": {
      "model": "gpt-6-luna"
    }
  },
  "fetch": {
    "timeoutMs": 15000,
    "github": {
      "enabled": true,
      "mode": "auto",
      "maxRepoSizeMB": 350,
      "cloneTimeoutSeconds": 120
    }
  }
}
