{
  "timeout": 20000,
  "servers": {
    "ruff": {
      "command": ["/home/tym/.local/bin/ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "biome": {
      "command": ["/home/tym/pi/node/bin/biome", "lsp-proxy"],
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".json",
        ".jsonc",
        ".css",
        ".html",
        ".vue",
        ".astro",
        ".svelte",
        ".graphql",
        ".gql"
      ]
    }
  }
}
